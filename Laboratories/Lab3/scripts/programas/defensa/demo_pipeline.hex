# demo_pipeline.hex - generado desde demo_pipeline.asm (no editar a mano)
# demo_pipeline — "Recorrido del pipeline (paso a paso)"
#
# QUE DEMUESTRA, una cosa por bloque: forwarding EX/MEM y MEM/WB, bypass del
# banco de registros, load-use (stall de 1 ciclo), salto no tomado (sin costo)
# y salto tomado (flush de 2 instrucciones). Usar Paso (F10) desde la carga.
#
# Resultado esperado (rv32i_model.py):
#   estado = 0x01 (HALT), ciclos = 22, PC = 0x00000048
#   registros distintos de 0: x1 = 0x00000005, x2 = 0x0000000A, x3 = 0x00000007, x4 = 0x0000000E, x5 = 0x00000009, x6 = 0x00000012, x7 = 0x0000000A, x8 = 0x00000014, x12 = 0x00000003
#   memoria que escribe el programa: mem[0] = 0x0000000A (el resto conserva lo que habia: la memoria no se borra)
00500093    # 0x000: addi x1, x0, 5
00108133    # 0x004: add  x2, x1, x1
00700193    # 0x008: addi x3, x0, 7
00000013    # 0x00C: nop   -> addi x0, x0, 0
00318233    # 0x010: add  x4, x3, x3
00900293    # 0x014: addi x5, x0, 9
00000013    # 0x018: nop   -> addi x0, x0, 0
00000013    # 0x01C: nop   -> addi x0, x0, 0
00528333    # 0x020: add  x6, x5, x5
00202023    # 0x024: sw   x2, 0(x0)
00002383    # 0x028: lw   x7, 0(x0)
00738433    # 0x02C: add  x8, x7, x7
00208863    # 0x030: beq  x1, x2, salto
00209663    # 0x034: bne  x1, x2, salto
06F00513    # 0x038: addi x10, x0, 111
0DE00593    # 0x03C: addi x11, x0, 222
00300613    # 0x040: salto:  addi x12, x0, 3
00000000    # 0x044: halt
