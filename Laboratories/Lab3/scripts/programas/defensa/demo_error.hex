# demo_error.hex - generado desde demo_error.asm (no editar a mano)
# demo_error — "Error: acceso fuera de memoria"
#
# QUE DEMUESTRA: un acceso a la direccion 128, fuera de la memoria de datos
# (0..127). El cpu se detiene con estado 0x05 (detenido + error), distinto
# de un HALT normal (0x01). El sw no escribe nada y lo que viene despues no
#
# Resultado esperado (rv32i_model.py):
#   estado = 0x05 (detenido por ERROR), ciclos = 5, PC = 0x0000000C
#   registros distintos de 0: x1 = 0x00000005
#   memoria que escribe el programa: ninguna (el resto conserva lo que habia: la memoria no se borra)
00500093    # 0x000: addi x1, x0, 5
08102023    # 0x004: sw   x1, 128(x0)
00000000    # 0x008: halt
