# demo_wow_fibonacci — "Wow: Fibonacci en memoria"
#
# QUE DEMUESTRA: un programa real que llena las 32 palabras de la memoria de
# datos con la serie de Fibonacci: F(0) = 0 ... F(31) = 1346269. En el loop hay
# forwarding MEM/WB -> EX (addi x2, x5, 0) y EX/MEM -> EX hacia la comparacion
#
# Resultado esperado (rv32i_model.py):
#   estado = 0x01 (HALT), ciclos = 262, PC = 0x0000002C
#   registros distintos de 0: x1 = 0x00213D05, x2 = 0x0035C7E2, x3 = 0x00000080, x4 = 0x00000080, x5 = 0x0035C7E2
#   memoria que escribe el programa: mem[0] = 0x00000000, mem[1] = 0x00000001, mem[2] = 0x00000001, mem[3] = 0x00000002, mem[4] = 0x00000003, mem[5] = 0x00000005, mem[6] = 0x00000008, mem[7] = 0x0000000D, mem[8] = 0x00000015, mem[9] = 0x00000022, mem[10] = 0x00000037, mem[11] = 0x00000059, mem[12] = 0x00000090, mem[13] = 0x000000E9, mem[14] = 0x00000179, mem[15] = 0x00000262, mem[16] = 0x000003DB, mem[17] = 0x0000063D, mem[18] = 0x00000A18, mem[19] = 0x00001055, mem[20] = 0x00001A6D, mem[21] = 0x00002AC2, mem[22] = 0x0000452F, mem[23] = 0x00006FF1, mem[24] = 0x0000B520, mem[25] = 0x00012511, mem[26] = 0x0001DA31, mem[27] = 0x0002FF42, mem[28] = 0x0004D973, mem[29] = 0x0007D8B5, mem[30] = 0x000CB228, mem[31] = 0x00148ADD (el resto conserva lo que habia: la memoria no se borra)
