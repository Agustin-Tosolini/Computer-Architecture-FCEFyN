# alu.hex - generado por ensamblador.py desde alu.asm (no editar a mano)
# Todas las operaciones de la ALU (tipo R e I) con casos borde: signo en
# slt/sra, sltu, desplazamientos de 0 y 31 bits, desborde y x0 como destino.
# Ciclos: 32 instrucciones + 4 = 36.
#
# Resultado esperado con el cpu real (rv32i_model.py):
#   estado = 0x01 (HALT), ciclos = 36, PC = 0x00000084
#   registros distintos de 0: x1 = 0xFFFFFFF8, x2 = 0x00000003, x3 = 0x80000000,
#       x4 = 0x0000001F, x5 = 0xFFFFFFFB, x6 = 0x0000000B, x7 = 0x80000000,
#       x8 = 0x00000001, x9 = 0xFFFFFFFF, x10 = 0xF0000000, x11 = 0x10000000,
#       x12 = 0xFFFFFFF8, x13 = 0x00000001, x16 = 0x00000001, x17 = 0xFFFFFFFB,
#       x18 = 0xFFFFFFFB, x20 = 0x000007F7, x21 = 0xFFFFFFF0, x22 = 0xFFFFF803,
#       x23 = 0x00000007, x24 = 0x00000001, x25 = 0x00000001, x26 = 0x80000000,
#       x27 = 0x00000001, x28 = 0xFFFFFFFF, x29 = 0xFFFFFFF8, x31 = 0x7FFFFFFD
#   memoria que escribe el programa: ninguna (el resto conserva lo que habia: la memoria no se borra)
FF800093    # 0x000: addi x1, x0, -8
00300113    # 0x004: addi x2, x0, 3
800001B7    # 0x008: lui  x3, 0x80000
01F00213    # 0x00C: addi x4, x0, 31
002082B3    # 0x010: add  x5, x1, x2
40110333    # 0x014: sub  x6, x2, x1
004113B3    # 0x018: sll  x7, x2, x4
0040D433    # 0x01C: srl  x8, x1, x4
4040D4B3    # 0x020: sra  x9, x1, x4
