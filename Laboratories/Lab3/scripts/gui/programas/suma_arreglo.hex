#   registros distintos de 0: x5 = 0x00000020, x7 = 0x0000001B, x10 = 0x0000006C, x28 = 0x00000018
#   memoria que escribe el programa: mem[0] = 0x00000003, mem[1] = 0x00000006, mem[2] = 0x00000009, mem[3] = 0x0000000C, mem[4] = 0x0000000F, mem[5] = 0x00000012, mem[6] = 0x00000015, mem[7] = 0x00000018, mem[8] = 0x0000006C (el resto conserva lo que habia: la memoria no se borra)
