# fibonacci.hex - generado desde fibonacci.asm (no editar a mano)
# Fibonacci: guarda F(0)..F(10) en mem[0..10] con un loop (bnez) y deja F(10)
# en a0, leyendo la memoria con lw. Usa pseudo-instrucciones (li, mv, bnez).
# Ciclos: 82 instrucciones + 2 x 10 saltos tomados + 4 = 106.
#
# Resultado esperado (rv32i_model.py):
#   estado = 0x01 (HALT), ciclos = 106, PC = 0x00000034
#   registros distintos de 0: x5 = 0x00000059, x6 = 0x00000090, x10 = 0x00000037, x28 = 0x0000002C, x29 = 0x00000090
#   memoria que escribe el programa: mem[0] = 0x00000000, mem[1] = 0x00000001, mem[2] = 0x00000001, mem[3] = 0x00000002, mem[4] = 0x00000003, mem[5] = 0x00000005, mem[6] = 0x00000008, mem[7] = 0x0000000D, mem[8] = 0x00000015, mem[9] = 0x00000022, mem[10] = 0x00000037 (el resto conserva lo que habia: la memoria no se borra)
00000293    # 0x000: li   t0, 0   -> addi t0, x0, 0
00100313    # 0x004: li   t1, 1   -> addi t1, x0, 1
