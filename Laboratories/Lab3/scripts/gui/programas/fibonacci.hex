00628EB3    # 0x014: add  t4, t0, t1
00030293    # 0x018: mv   t0, t1   -> addi t0, t1, 0
000E8313    # 0x01C: mv   t1, t4   -> addi t1, t4, 0
004E0E13    # 0x020: addi t3, t3, 4
